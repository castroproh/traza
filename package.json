{
  "name": "traza",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TRAZA: laboratorio de diagnóstico contrastivo adaptativo del razonamiento algorítmico (motor 0.1).",
  "scripts": {
    "prepare:pyodide": "node scripts/copy-pyodide.mjs",
    "dev": "npm run prepare:pyodide && vite",
    "build": "npm run prepare:pyodide && vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "pyodide": "0.27.2",
    "vue": "3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "5.2.1",
    "typescript": "5.6.3",
    "vite": "6.0.7",
    "vitest": "2.1.8",
    "vue-tsc": "2.1.10"
  }
}
