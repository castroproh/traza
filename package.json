{
  "name": "traza",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "TRAZA: recorrido PACT (predicción, análisis, contraste y transferencia) para el razonamiento algorítmico (0.7.0).",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "prepare:pyodide": "node scripts/copy-pyodide.mjs",
    "dev": "npm run prepare:pyodide && vite",
    "build": "npm run prepare:pyodide && vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "pyodide": "0.27.2",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "5.2.1",
    "typescript": "5.6.3",
    "vite": "6.4.6",
    "vitest": "5.1.1",
    "vue-tsc": "3.3.14"
  }
}
